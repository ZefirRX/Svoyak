<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}" Foreground="#0B1A3F" FontFamily="Segoe UI" FontSize="15" x:Class="Svoyak.MainWindow" Title="Quiz Helper — КЦСОН Московского района" Width="1280" Height="820" MinWidth="1050" MinHeight="680" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="White" BorderThickness="0,0,0,1" Padding="20,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="← В меню" Click="OpenMenu" Margin="0"/>
                <Image Source="Assets/logo.png" Width="140" Height="52" Margin="0,0,16,0"/>
                <TextBlock Text="Quiz Helper" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="ModeLabel" Foreground="#2E3F78" Margin="20,0" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Grid Margin="20">
            <Grid x:Name="MenuView">
                <StackPanel Width="820" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="360" Margin="0,0,0,30"/>
                    <TextBlock Text="Что будем делать?" FontSize="44" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="Игры создаются и правятся только в редакторе, а проводятся в режиме игры." TextAlignment="Center" Foreground="#2E3F78" Margin="0,8,0,24"/>
                    <UniformGrid Columns="2">
                        <Button Click="OpenLibrary" Background="{StaticResource CardBrush}" Padding="24" Height="190" Margin="0,0,8,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Редактор" FontSize="24" Margin="0,0,0,12"/>
                                <TextBlock Text="Создавайте шаблоны игр: темы, вопросы, ответы, баллы. Готовые игры сохраняются на этом устройстве." Foreground="#2E3F78"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OpenSetup" Background="{StaticResource CardBrush}" Padding="24" Height="190" Margin="8,0,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Провести игру" FontSize="24" Margin="0,0,0,12"/>
                                <TextBlock Text="Выберите сохранённую игру, задайте команды и начните. Состав вопросов в этом режиме не меняется." Foreground="#2E3F78"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="LibraryView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}" Width="880" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="+ Создать игру" Click="CreateGame" Margin="0"/>
                            <TextBlock Text="СОХРАНЁННЫЕ ИГРЫ" Style="{StaticResource Heading}" VerticalAlignment="Center" Margin="0"/>
                        </DockPanel>
                        <StackPanel x:Name="LibraryRows"/>
                        <TextBlock Text="Игры сохраняются на этом устройстве. Любую можно открыть и дополнить в редакторе." Foreground="#2E3F78"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <Grid x:Name="EditorView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Отмена" Click="OpenLibrary" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Сохранить" Click="SaveGame" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Сохранить и выйти" Style="{StaticResource Primary}" Click="SaveAndExit" VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>
                    <TextBlock Text="Редактирование игры" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Название игры"/>
                                <TextBox x:Name="GameTitle" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="ТЕМЫ" Style="{StaticResource Heading}"/>
                                <ListBox x:Name="TopicList" DisplayMemberPath="Title" SelectionChanged="SelectTopic" MaxHeight="350"/>
                                <Button Content="+ Добавить тему" Click="AddTopic"/>
                                <Button Content="Удалить тему" Foreground="#8F1D1D" Click="DeleteTopic"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Название темы"/>
                                <TextBox x:Name="TopicTitle" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="ВОПРОСЫ" Style="{StaticResource Heading}"/>
                                <ListBox x:Name="QuestionList" SelectionChanged="SelectQuestion" MaxHeight="400">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Points}" FontWeight="Bold" Width="50" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="{Binding Text}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="+ Добавить вопрос" Click="AddQuestion"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel x:Name="QuestionForm">
                                <TextBlock Text="ВОПРОС" Style="{StaticResource Heading}"/>
                                <TextBlock Text="Текст вопроса"/>
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                <TextBlock Text="Ответ"/>
                                <TextBox Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Баллы"/>
                                        <TextBox x:Name="PointsInput" Text="{Binding Points, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Таймер, сек"/>
                                        <TextBox x:Name="SecondsInput" Text="30" LostFocus="SaveTimerSetting"/>
                                    </StackPanel>
                                </UniformGrid>
                                <Button Content="Выбрать медиафайл…" Click="ChooseMedia"/>
                                <TextBlock Text="{Binding MediaPath}" FontSize="12"/>
                                <Button Content="Удалить вопрос" Foreground="#8F1D1D" Click="DeleteQuestion"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
            <ScrollViewer x:Name="SetupView" Visibility="Collapsed" MaxWidth="1000" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="280"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="1. ВЫБЕРИТЕ ИГРУ" Style="{StaticResource Heading}"/>
                            <ListBox x:Name="GameList" Grid.Row="1" DisplayMemberPath="Title"/>
                            <Button Grid.Row="2" Content="✎ Изменить эту игру в редакторе" Click="EditSelectedGame" Margin="0,12,0,0"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="2. КОМАНДЫ" Style="{StaticResource Heading}" Grid.Row="0"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="1">
                                <TextBlock Text="Количество" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="−" Click="RemoveTeam" Width="44" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TeamCount" FontSize="24" Width="44" TextAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                                <Button Content="+" Click="AddTeam" Width="44" Margin="0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <UniformGrid x:Name="TeamInputs" Columns="2" Grid.Row="2" VerticalAlignment="Top"/>
                            <Button Content="Начать игру →" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="StartGame" Grid.Row="3" Margin="0,12,0,0" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
            <Grid x:Name="BoardView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Показ на втором экране" Click="OpenProjector" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Завершить игру" Foreground="#8F1D1D" Click="FinishGame" VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>
                    <TextBlock x:Name="BoardTitle" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <Grid x:Name="BoardCells" VerticalAlignment="Top"/>
                    </ScrollViewer>
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                            <StackPanel>
                                <TextBlock Text="СЧЁТ КОМАНД" Style="{StaticResource Heading}"/>
                                <StackPanel x:Name="ScoreRows"/>
                                <TextBlock x:Name="LastAction" Foreground="#2E3F78" Margin="0,8"/>
                                <Button x:Name="UndoButton" Content="↶ Отменить последнее" Click="UndoScore"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="QuestionView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Показ на втором экране" Click="OpenProjector" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TimerText" FontSize="34" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" MinWidth="96" TextAlignment="Center"/>
                        <Button x:Name="TimerButton" Content="Старт" Style="{StaticResource Primary}" Click="ToggleTimer" VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="← На табло" Click="ReturnToBoard" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="QuestionTitle" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="440"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="QuestionText" FontSize="40" FontWeight="SemiBold" Margin="0,0,0,20"/>
                        <Border Grid.Row="1" BorderBrush="#7F98C9" BorderThickness="2" CornerRadius="12" Padding="12" ClipToBounds="True">
                            <DockPanel x:Name="MediaPanel" LastChildFill="True"/>
                        </Border>
                    </Grid>
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                            <StackPanel>
                                <TextBlock Text="ТОЛЬКО ДЛЯ ВЕДУЩЕГО" Style="{StaticResource Heading}"/>
                                <Button x:Name="AnswerButton" Content="Показать ответ" Click="RevealAnswer"/>
                                <TextBlock x:Name="AnswerText" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16" Visibility="Collapsed"/>
                                <TextBlock Text="КТО ОТВЕТИЛ?" Style="{StaticResource Heading}"/>
                                <StackPanel x:Name="AnswerTeams"/>
                                <Button Content="Никто не ответил" Click="SkipQuestion"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
            <Border x:Name="ResultsView" Visibility="Collapsed" Style="{StaticResource Card}" Width="640" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock x:Name="ResultsTitle" Style="{StaticResource Heading}"/>
                    <StackPanel x:Name="ResultRows"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Новая игра" Style="{StaticResource Primary}" Click="OpenSetup"/>
                        <Button Content="← К табло" HorizontalAlignment="Left" Click="ReturnToBoard"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
