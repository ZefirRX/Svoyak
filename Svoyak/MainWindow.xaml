<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}" Foreground="#0B1A3F" FontFamily="Segoe UI" FontSize="14" x:Class="Svoyak.MainWindow" Icon="Assets/Svoyak.ico" Title="Quiz Helper — КЦСОН Московского района" Width="1160" Height="740" MinWidth="1050" MinHeight="680" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="RowActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="CopyRowButton" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.4"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M 5,4 V 1 H 13 V 11 H 10 M 1,4 H 10 V 14 H 1 Z"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DeleteRowButton" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
            <Setter Property="Foreground" Value="#8F1D1D"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.4"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M 1,4 H 13 M 5,4 V 2 H 9 V 4 M 3,4 L 4,14 H 10 L 11,4 M 6,6 V 12 M 8,6 V 12"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="White" BorderThickness="0,0,0,1" Padding="12,5">
            <DockPanel>
                <Button x:Name="MenuButton" Visibility="Collapsed" DockPanel.Dock="Right" Content="← В меню" Click="OpenMenu" Margin="0"/>
                <Image Source="Assets/logo.png" Width="104" Height="36" Margin="0,0,10,0"/>
                <TextBlock Text="Quiz Helper" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="ModeLabel" Foreground="#2E3F78" Margin="12,0" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Grid Margin="12">
            <Grid x:Name="MenuView">
                <StackPanel MaxWidth="660" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="240" Margin="0,0,0,14"/>
                    <TextBlock Text="Что будем делать?" FontSize="30" FontWeight="SemiBold" TextAlignment="Center"/>
                    <UniformGrid Columns="2" Margin="0,14,0,0">
                        <Button Click="OpenLibrary" Background="{StaticResource CardBrush}" Padding="12,10" MinHeight="86" VerticalAlignment="Stretch" Margin="0,0,8,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Редактор" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Создавайте игры и редактируйте темы и вопросы." Foreground="#2E3F78"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OpenSetup" Background="{StaticResource CardBrush}" Padding="12,10" MinHeight="86" VerticalAlignment="Stretch" Margin="8,0,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Провести игру" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Выберите сохранённую игру и настройте команды." Foreground="#2E3F78"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="LibraryView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}" MaxWidth="760" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="+ Создать игру" Click="CreateGame" Margin="0"/>
                            <TextBlock Text="СОХРАНЁННЫЕ ИГРЫ" Style="{StaticResource Heading}" VerticalAlignment="Center" Margin="0"/>
                        </DockPanel>
                        <StackPanel x:Name="LibraryRows"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <Grid x:Name="EditorView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Отмена" Click="OpenLibrary" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Сохранить" Click="SaveGame" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Сохранить и выйти" Style="{StaticResource Primary}" Click="SaveAndExit" VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>
                    <TextBlock Text="Редактирование игры" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Название игры"/>
                                <TextBox x:Name="GameTitle" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="ТЕМЫ" Style="{StaticResource Heading}"/>
                                <ListBox x:Name="TopicList" SelectionChanged="SelectTopic" MaxHeight="350">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource DeleteRowButton}" ToolTip="Удалить тему"
                                                        AutomationProperties.Name="Удалить тему" Click="DeleteTopic"/>
                                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Название темы" ToolTip="Редактировать название темы"
                                                         GotKeyboardFocus="FocusTopicTitle">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                            <Setter Property="Margin" Value="0"/>
                                                            <Setter Property="Padding" Value="0"/>
                                                            <Setter Property="MinHeight" Value="26"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button HorizontalAlignment="Left" Content="+ Добавить тему" Click="AddTopic"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="ВОПРОСЫ" Style="{StaticResource Heading}"/>
                                <ListBox x:Name="QuestionList" SelectionChanged="SelectQuestion" MaxHeight="400">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource DeleteRowButton}" ToolTip="Удалить вопрос"
                                                        AutomationProperties.Name="Удалить вопрос" Click="DeleteQuestion"/>
                                                <TextBlock Text="{Binding Points}" FontWeight="Bold" Width="40" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button HorizontalAlignment="Left" Content="+ Добавить вопрос" Click="AddQuestion"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel x:Name="QuestionForm">
                                <TextBlock Text="ВОПРОС" Style="{StaticResource Heading}"/>
                                <TextBlock Text="Текст вопроса"/>
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Height="84" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                <TextBlock Text="Ответ"/>
                                <TextBox Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Баллы"/>
                                        <TextBox x:Name="PointsInput" Text="{Binding Points, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Таймер, сек"/>
                                        <TextBox x:Name="SecondsInput" Text="30" LostFocus="SaveTimerSetting"/>
                                    </StackPanel>
                                </UniformGrid>
                                <Button HorizontalAlignment="Left" Content="Выбрать медиафайл…" Click="ChooseMedia"/>
                                <TextBlock Text="{Binding MediaPath}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
            <ScrollViewer x:Name="SetupView" Visibility="Collapsed" MaxWidth="880" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="1. ВЫБЕРИТЕ ИГРУ" Style="{StaticResource Heading}"/>
                            <ListBox x:Name="GameList" MaxHeight="260">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SelectedGameMark" Text="✓" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                       Visibility="Hidden"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Width="28" MinHeight="26" Padding="0" Margin="0"
                                                    ToolTip="Редактировать игру" AutomationProperties.Name="Редактировать игру"
                                                    Click="EditGameFromSetup">
                                                <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.4"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Data="M 10,2 L 2,2 2,15 12,15 12,9 M 5,11 L 6,8 12,2 14,4 8,10 Z"/>
                                            </Button>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="SelectedGameMark" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="2. КОМАНДЫ" Style="{StaticResource Heading}" Grid.Row="0"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,8">
                                <TextBlock Text="Количество" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Click="RemoveTeam" Width="34" Padding="0" Margin="0" VerticalAlignment="Center"
                                        AutomationProperties.Name="Уменьшить число команд">
                                    <Canvas Width="12" Height="12">
                                        <Path Data="M 1,6 H 11" StrokeThickness="2"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Canvas>
                                </Button>
                                <TextBlock x:Name="TeamCount" FontSize="18" Width="34" TextAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                                <Button Click="AddTeam" Width="34" Padding="0" Margin="0" VerticalAlignment="Center"
                                        AutomationProperties.Name="Увеличить число команд">
                                    <Canvas Width="12" Height="12">
                                        <Path Data="M 1,6 H 11 M 6,1 V 11" StrokeThickness="2"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Canvas>
                                </Button>
                            </StackPanel>
                            <UniformGrid x:Name="TeamInputs" Columns="2" Grid.Row="2" VerticalAlignment="Top"/>
                            <Button Content="Начать игру →" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="StartGame" Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
            <Grid x:Name="BoardView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Показ на втором экране" Click="OpenProjector" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Завершить игру" Foreground="#8F1D1D" Click="FinishGame" VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>
                    <TextBlock x:Name="BoardTitle" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="284"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <Grid x:Name="BoardCells" VerticalAlignment="Top"/>
                    </ScrollViewer>
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                            <StackPanel>
                                <TextBlock Text="СЧЁТ КОМАНД" Style="{StaticResource Heading}"/>
                                <StackPanel x:Name="ScoreRows"/>
                                <TextBlock x:Name="LastAction" Foreground="#2E3F78" Margin="0,8"/>
                                <Button x:Name="UndoButton" Content="↶ Отменить последнее" Click="UndoScore"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="QuestionView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Показ на втором экране" Click="OpenProjector" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TimerText" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" MinWidth="76" TextAlignment="Center"/>
                        <Button x:Name="TimerButton" Content="Старт" Style="{StaticResource Primary}" Click="ToggleTimer" VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="← На табло" Click="ReturnToBoard" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="QuestionTitle" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="QuestionText" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border x:Name="MediaFrame" Grid.Row="1" BorderBrush="#7F98C9" BorderThickness="1" CornerRadius="8" Padding="8" ClipToBounds="True">
                            <DockPanel x:Name="MediaPanel" LastChildFill="True"/>
                        </Border>
                    </Grid>
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                            <StackPanel>
                                <TextBlock Text="ТОЛЬКО ДЛЯ ВЕДУЩЕГО" Style="{StaticResource Heading}"/>
                                <Button x:Name="AnswerButton" Content="Показать ответ" Click="RevealAnswer"/>
                                <TextBlock x:Name="AnswerText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" Visibility="Collapsed"/>
                                <TextBlock Text="КТО ОТВЕТИЛ?" Style="{StaticResource Heading}"/>
                                <StackPanel x:Name="AnswerTeams"/>
                                <Button Content="Никто не ответил" Click="SkipQuestion"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
            <Border x:Name="ResultsView" Visibility="Collapsed" Style="{StaticResource Card}" MaxWidth="580" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock x:Name="ResultsTitle" Style="{StaticResource Heading}"/>
                    <StackPanel x:Name="ResultRows"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Новая игра" Style="{StaticResource Primary}" Click="OpenSetup"/>
                        <Button Content="← К табло" HorizontalAlignment="Left" Click="ReturnToBoard"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
