<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Svoyak.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <DefineConstants>$(DefineConstants);SINGLE_FILE</DefineConstants>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <SeedDatabasePath Condition="'$(SeedDatabasePath)' == ''">..\SQLite_Svoyak.db</SeedDatabasePath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(SeedDatabasePath)"
                      LogicalName="Svoyak.SQLite_Svoyak.db"
                      Condition="'$(PublishSingleFile)' == 'true'" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\Svoyak.ico" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
  </ItemGroup>

</Project>



